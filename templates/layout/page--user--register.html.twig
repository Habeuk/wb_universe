{#
/**
 * @file
 * Theme override for user registration page
 */
#}
{% extends "@wb_universe/layout/page--user.html.twig" %}

{% block user_content %}
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4 p-md-5">
      
      <div class="text-center mb-4">
        {% if logo %}
          <a href="{{ front_page }}" class="d-inline-block mb-3">
            <img src="{{ logo }}" alt="{{ 'Home'|t }}" class="img-fluid" width="150">
          </a>
        {% endif %}
        {% if site_name %}
          <h1 class="h5 mb-1 fw-semibold">{{ site_name }}</h1>
        {% endif %}
       <h3 class="text-muted my-4">{{ page['#title'] }}</h3>
      </div>
      
      {{ page.content }}
      
      <div class="mt-4 pt-3 border-top text-center">
        <p class="small text-muted mb-2">
          {{ 'Already have an account?'|t }}
        </p>
        <a href="{{ path('user.login') }}" class="text-decoration-none small">
          {{ 'Sign in'|t }}
        </a>
      </div>
      
    </div>
  </div>
{% endblock %}