{#
/**
 * @file
 * Theme override for user account pages
 *
 * This is the parent template for all user-related pages.
 * Child templates only need to override the user_content block.
 */
#}
{% extends "@wb_universe/layout/page.html.twig" %}
{% block main_content %}
  <div class="user-page bg-light">
    
      {# ========== LAYOUT AUTHENTIFIÉ ========== #}
      <div class="container">
        <div class="row">          
          <div class="col-12">
            {% block user_messages_block %}
              {% if user_messages %}
                <div class="mb-4">
                  {{ user_messages }}
                </div>
              {% endif %}
            {% endblock %}
            
            {% if page.highlighted %}
              <div class="mb-4">
                {{ page.highlighted }}
              </div>
            {% endif %}
            {% block user_tabs_block %}
                {% if user_tabs %}
                  <div class="mb-4">
                    {{ user_tabs }}
                  </div>
                {% endif %}
            {% endblock %}
            {% block user_content %}
            	<div class="space-padding">{{ page.content }}</div>
            {% endblock %}
          </div>          
        </div>
      </div>      

      {# ========== LAYOUT NON-AUTHENTIFIÉ ========== 
      <div class="min-vh-100 space-padding d-flex align-items-center justify-content-center bg-light">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
              
              {{ block('user_messages_block') }}
              
              {% if page.highlighted %}
                <div class="mb-4">
                  {{ page.highlighted }}
                </div>
              {% endif %}
              
              {{ block('user_content') }}
              
              {% block user_footer_links %}{% endblock %}
              
            </div>
          </div>
        </div>
      </div>
      #}
    
  </div>
{% endblock %}