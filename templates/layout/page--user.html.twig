{#
/**
 * @file
 * Theme override for user account pages
 *
 * This is the parent template for all user-related pages.
 * Child templates only need to override the user_content block.
 */
#}
{% extends "@wb_universe/layout/page.html.twig" %}

{% block top_header %}
	{% if logged_in %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block hero_slider %}
	{% if logged_in %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block call_to_action %}
	{% if logged_in %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block header %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block before_content %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block after_content %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block footer %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block main_content %}
  <div class="user-page">
    
    {% if logged_in %}
      {# ========== LAYOUT AUTHENTIFIÉ ========== #}
      <div class="container">
        <div class="row">          
          <div class="col-12">
            {% block user_messages_block %}
              {% if user_messages %}
                <div class="mb-4">
                  {{ user_messages }}
                </div>
              {% endif %}
            {% endblock %}
            
            {% if page.highlighted %}
              <div class="mb-4">
                {{ page.highlighted }}
              </div>
            {% endif %}
            
            {% block user_content %}
              <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                  {{ page.content }}
                </div>
              </div>
            {% endblock %}
          </div>          
        </div>
      </div>
      
    {% else %}
      {# ========== LAYOUT NON-AUTHENTIFIÉ ========== #}
      <div class="min-vh-100 space-padding d-flex align-items-center justify-content-center bg-light">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
              
              {% block user_tabs_block %}
                {% if user_tabs %}
                  <div class="mb-4">
                    {{ user_tabs }}
                  </div>
                {% endif %}
              {% endblock %}
              
              {{ block('user_messages_block') }}
              
              {% if page.highlighted %}
                <div class="mb-4">
                  {{ page.highlighted }}
                </div>
              {% endif %}
              
              {{ block('user_content') }}
              
              {% block user_footer_links %}{% endblock %}
              
            </div>
          </div>
        </div>
      </div>
    {% endif %}
    
  </div>
{% endblock %}