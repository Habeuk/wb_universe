{#
/**
 * @file
 * Theme override for user password reset page
 */
#}
{% extends "@wb_universe/layout/page--user.html.twig" %}
{% block top_header %}
	{% if logged_in %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block hero_slider %}
	{% if logged_in %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block call_to_action %}
	{% if logged_in %}
		{{ parent() }}
	{% endif %}
{% endblock %}

{% block header %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block before_content %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block after_content %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block footer %}
  {% if logged_in %}
    {{ parent() }}
  {% endif %}
{% endblock %}

{% block user_content %}
<div class="min-vh-100 space-padding d-flex align-items-center justify-content-center bg-light">
	<div class="row justify-content-center">
		<div class="col-12 col-md-8">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4 p-md-5">
      
      <div class="text-center mb-4">
        {% if logo %}
          <a href="{{ front_page }}" class="d-inline-block mb-3">
            <img src="{{ logo }}" alt="{{ 'Home'|t }}" class="img-fluid" width="150">
          </a>
        {% endif %}
        {% if site_name %}
          <h1 class="h5 mb-1 fw-semibold">{{ site_name }}</h1>
        {% endif %}
        <h3 class="text-muted my-4">{{ page['#title'] }}</h3>
      </div>
      
      {{ page.content }}
      
      <div class="mt-4 pt-3 border-top text-center">
        <a href="{{ path('user.login') }}" class="text-decoration-none small">
          {{ '← Back to login'|t }}
        </a>
      </div>
      
    </div>
  </div>
  </div>
  </div>
  </div>  
{% endblock %}